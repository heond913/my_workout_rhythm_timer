# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ADMOB_APP_ID: Your production AdMob App ID.
# Format: ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
# Default value is the Google official test App ID.
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713

# ADMOB_INTERSTITIAL_AD_UNIT_ID: Your production Interstitial Ad Unit ID.
# Format: ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# Default value is the Google official test Interstitial Ad Unit ID.
ADMOB_INTERSTITIAL_AD_UNIT_ID=ca-app-pub-3940256099942544/1033173712
